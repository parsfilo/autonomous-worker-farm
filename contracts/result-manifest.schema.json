{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-worker.local/schemas/result-manifest.schema.json",
  "title": "ResultManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt_id",
    "attempt_no",
    "base_sha",
    "repo_passport_hash",
    "context_snapshot_hash",
    "machine",
    "sandbox",
    "harness",
    "model",
    "started_at",
    "ended_at",
    "status",
    "changed_files",
    "candidate_hash",
    "commands",
    "checks",
    "tests",
    "quality",
    "policy_events",
    "network_events",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repo_passport_hash": {
      "$ref": "#/$defs/sha256"
    },
    "context_snapshot_hash": {
      "$ref": "#/$defs/sha256"
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_id"
      ],
      "properties": {
        "machine_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "os": {
          "type": "string",
          "maxLength": 128
        },
        "kernel": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "attested"
      ],
      "properties": {
        "tier": {
          "enum": [
            "T0",
            "T1",
            "T2"
          ]
        },
        "attested": {
          "type": "boolean"
        },
        "landlock_abi": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "container_runtime": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "container_image_digest": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "version"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_ids": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "approved_skills": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/versionedRef"
      },
      "default": []
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 128
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "LOST",
        "POLICY_VIOLATION"
      ]
    },
    "changed_files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "patch_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_hash": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_commit_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "commands": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "exit_code",
          "duration_ms"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "exit_code": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "stdout_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "stderr_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/gateEvidence"
      }
    },
    "lsp_diagnostics": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semgrep",
        "codacy",
        "sonar"
      ],
      "properties": {
        "semgrep": {
          "$ref": "#/$defs/gateEvidence"
        },
        "codacy": {
          "$ref": "#/$defs/gateEvidence"
        },
        "sonar": {
          "$ref": "#/$defs/gateEvidence"
        }
      }
    },
    "policy_events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "network_events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uri": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        }
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "lint",
        "typecheck",
        "build",
        "secret_scan"
      ],
      "properties": {
        "format": {
          "$ref": "#/$defs/gateEvidence"
        },
        "lint": {
          "$ref": "#/$defs/gateEvidence"
        },
        "typecheck": {
          "$ref": "#/$defs/gateEvidence"
        },
        "build": {
          "$ref": "#/$defs/gateEvidence"
        },
        "secret_scan": {
          "$ref": "#/$defs/gateEvidence"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "SKIP",
            "NOT_APPLICABLE",
            "ERROR",
            "MISSING"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "details": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "kind"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "decision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "details": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
