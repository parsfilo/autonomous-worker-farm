{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-worker.local/schemas/validation-plan.schema.json",
  "title": "ValidationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "candidate_hash",
    "base_sha",
    "validation_workspace",
    "commands",
    "scanner_profiles",
    "network_profile",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "validation_workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "commands": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "argv",
          "required",
          "timeout_seconds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "required": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          }
        }
      }
    },
    "scanner_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semgrep",
        "codacy",
        "sonar"
      ],
      "properties": {
        "semgrep": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "codacy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "sonar": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "network_profile": {
      "enum": [
        "none",
        "quality-services"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14400
    }
  }
}
