{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-worker.local/schemas/github-pr-publication.schema.json",
  "title": "GitHubPrPublication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provider", "repo_id", "task_id", "attempt_id",
    "integration_artifact_hash", "branch", "pr_number", "pr_url",
    "base_ref", "base_sha", "head_sha"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "provider": { "const": "github" },
    "repo_id": { "type": "string", "minLength": 3, "maxLength": 256 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "integration_artifact_hash": { "$ref": "#/$defs/sha256" },
    "branch": {
      "type": "string",
      "pattern": "^awf/candidate-[0-9a-f]{24}$"
    },
    "pr_number": { "type": "integer", "minimum": 1 },
    "pr_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "base_ref": { "type": "string", "minLength": 1, "maxLength": 255 },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "head_sha": { "$ref": "#/$defs/gitSha" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
