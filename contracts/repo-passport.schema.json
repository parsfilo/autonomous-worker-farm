{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-worker.local/schemas/repo-passport.schema.json",
  "title": "RepoPassport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo_id",
    "visibility",
    "trust_tier",
    "default_branch",
    "protected_paths",
    "generated_paths",
    "vendor_paths",
    "languages",
    "frameworks",
    "allowed_build_commands",
    "allowed_test_commands",
    "quality",
    "network_profiles",
    "max_parallel_tasks",
    "max_open_prs",
    "allowed_harnesses",
    "allowed_model_classes",
    "independent_review_required",
    "merge_method",
    "post_merge_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "visibility": {
      "enum": [
        "public",
        "private",
        "internal"
      ]
    },
    "trust_tier": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "PROTECTED"
      ]
    },
    "default_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "protected_paths": {
      "$ref": "#/$defs/paths"
    },
    "generated_paths": {
      "$ref": "#/$defs/paths"
    },
    "vendor_paths": {
      "$ref": "#/$defs/paths"
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "frameworks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "allowed_build_commands": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/argv"
      }
    },
    "allowed_test_commands": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/argv"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "lint",
        "typecheck",
        "build",
        "tests",
        "secret_scan",
        "semgrep",
        "codacy",
        "sonar"
      ],
      "properties": {
        "format": {
          "$ref": "#/$defs/gateRequirement"
        },
        "lint": {
          "$ref": "#/$defs/gateRequirement"
        },
        "typecheck": {
          "$ref": "#/$defs/gateRequirement"
        },
        "build": {
          "$ref": "#/$defs/gateRequirement"
        },
        "tests": {
          "$ref": "#/$defs/gateRequirement"
        },
        "secret_scan": {
          "$ref": "#/$defs/gateRequirement"
        },
        "semgrep": {
          "$ref": "#/$defs/gateRequirement"
        },
        "codacy": {
          "$ref": "#/$defs/gateRequirement"
        },
        "sonar": {
          "$ref": "#/$defs/gateRequirement"
        }
      }
    },
    "network_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "max_parallel_tasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_open_prs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "allowed_harnesses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "allowed_model_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fast",
          "coding",
          "deep-reasoning",
          "review",
          "frontier"
        ]
      }
    },
    "independent_review_required": {
      "type": "boolean"
    },
    "merge_method": {
      "enum": [
        "squash",
        "merge",
        "rebase"
      ]
    },
    "post_merge_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "gateRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "profile": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    }
  }
}
