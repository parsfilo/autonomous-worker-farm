{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-worker.local/schemas/egress-profile.schema.json",
  "title": "EgressProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "gateway_image",
    "internal_network",
    "routes",
    "package_proxy",
    "limits",
    "policy_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "gateway_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "internal_network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway_alias",
        "llm_port",
        "http_proxy_port",
        "direct_egress_denied"
      ],
      "properties": {
        "gateway_alias": {
          "const": "awf-egress"
        },
        "llm_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "http_proxy_port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1024,
          "maximum": 65535
        },
        "direct_egress_denied": {
          "const": true
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "provider_id",
          "protocol",
          "upstream_base_url",
          "worker_base_path",
          "worker_auth",
          "upstream_auth",
          "secret_handle",
          "models",
          "request_path_prefixes"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "provider_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "protocol": {
            "enum": [
              "openai-responses",
              "openai-chat",
              "openai-compatible",
              "openai-compatible-responses",
              "anthropic",
              "opencode-free-connect"
            ]
          },
          "upstream_base_url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$",
            "maxLength": 1024
          },
          "upstream_auth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "header_name"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "bearer",
                  "header",
                  "none"
                ]
              },
              "header_name": {
                "type": "string",
                "maxLength": 128
              }
            }
          },
          "secret_handle": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "request_path_prefixes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$",
              "maxLength": 256
            }
          },
          "worker_auth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "header_name",
              "secret_file"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "bearer",
                  "header",
                  "none"
                ]
              },
              "header_name": {
                "type": "string",
                "maxLength": 128
              },
              "secret_file": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "/run/egress/attempt-token",
                  null
                ]
              }
            }
          },
          "worker_base_path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$",
            "maxLength": 256
          }
        }
      }
    },
    "package_proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowed_hosts",
        "allowed_ports"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowed_hosts": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\*\\.)?[A-Za-z0-9.-]+$",
            "maxLength": 253
          }
        },
        "allowed_ports": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_request_bytes",
        "max_response_bytes",
        "max_concurrent_requests"
      ],
      "properties": {
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 134217728
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1073741824
        },
        "max_concurrent_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
