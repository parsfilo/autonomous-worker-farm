{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-worker.local/schemas/quality-profile.schema.json",
  "title": "QualityProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "runner",
    "commands",
    "scanner_profiles",
    "network_profile",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "runner": {
      "const": "landlock-local-v1"
    },
    "commands": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "argv",
          "timeout_seconds"
        ],
        "properties": {
          "gate": {
            "enum": [
              "format",
              "lint",
              "typecheck",
              "build",
              "tests",
              "secret_scan"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          }
        }
      }
    },
    "scanner_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semgrep",
        "codacy",
        "sonar"
      ],
      "properties": {
        "semgrep": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "codacy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "sonar": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "network_profile": {
      "enum": [
        "none",
        "quality-services"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14400
    }
  }
}
