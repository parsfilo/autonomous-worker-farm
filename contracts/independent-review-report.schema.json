{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-worker.local/schemas/independent-review-report.schema.json",
  "title": "IndependentReviewReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "source_attempt_id",
    "review_attempt_id",
    "candidate_hash",
    "patch_sha256",
    "base_sha",
    "verdict",
    "findings",
    "summary",
    "reviewer",
    "sandbox",
    "started_at",
    "ended_at",
    "raw_output_sha256",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "review_attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "BLOCK"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "code",
          "summary",
          "path",
          "line"
        ],
        "properties": {
          "severity": {
            "enum": [
              "BLOCKING",
              "NON_BLOCKING"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10000000
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_id",
        "provider",
        "model",
        "harness_adapter",
        "harness_version"
      ],
      "properties": {
        "machine_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "const": "opencode"
        },
        "model": {
          "type": "string",
          "pattern": "^opencode/[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "harness_adapter": {
          "const": "opencode"
        },
        "harness_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "request_hash",
        "image_digest",
        "network_profile",
        "workspace_read_only"
      ],
      "properties": {
        "tier": {
          "const": "T1"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "network_profile": {
          "const": "brokered"
        },
        "workspace_read_only": {
          "const": true
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
